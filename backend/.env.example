# ================= Chatversio AI Email CRM — .env =================

# --- Core ---
DEBUG=false
DATABASE_URL=sqlite:///./chatversio.db
# Production (Hostinger VPS): postgresql://user:pass@localhost:5432/chatversio
FRONTEND_ORIGIN=http://192.168.0.104:5173
SERVE_FRONTEND=false
AUTO_SEED=true

# --- Admin login (single account, NO registration) ---
ADMIN_EMAIL=you@chatversio.ai
ADMIN_PASSWORD=set-a-strong-password-here
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste-long-random-string-here

# --- Super Admin (AI usage + API keys page only). If blank, main admin is promoted. ---
SUPERADMIN_EMAIL=super@chatversio.ai
SUPERADMIN_PASSWORD=set-a-strong-password
JWT_EXPIRE_HOURS=12
OTP_ENABLED=true
OTP_EXPIRE_MINUTES=10

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
LLM_PROVIDER=openai
# OpenAI/Tavily keys can be left BLANK here and set from Super Admin -> API Keys
# (stored encrypted at rest with AES-GCM, no plaintext, no restart needed).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODERATION=true

# --- Tavily (advanced research: company + person + website + country) ---
TAVILY_API_KEY=
TAVILY_DEPTH=advanced

# --- Embeddings (knowledge base). pgvector auto-used on Postgres. ---
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
EMBED_CHUNK_SIZE=800
EMBED_CHUNK_OVERLAP=120

# --- Outbound SMTP (Gmail: App Password required; Hostinger: smtp.hostinger.com:587) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=agents@yourdomain.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=agents@yourdomain.com
SMTP_FROM_NAME=Chatversio AI

# --- DKIM signing (optional in-code signing; DNS records still the main game) ---
# openssl genrsa -out dkim_private.pem 2048
DKIM_DOMAIN=
DKIM_SELECTOR=default
DKIM_PRIVATE_KEY_PATH=

# --- Inbound IMAP (Gmail: imap.gmail.com; Hostinger: imap.hostinger.com:993) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=agents@yourdomain.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# --- Behaviour (defaults; Settings page + per-agent config can override) ---
OUTBOUND_DELAY_MIN_SECONDS=180
OUTBOUND_DELAY_MAX_SECONDS=720
INBOUND_REPLY_DELAY_SECONDS=900
FOLLOWUP_AFTER_HOURS=24
MAX_FOLLOWUPS=3
BATCH_SIZE_MIN=20
BATCH_SIZE_MAX=50
GARBAGE_RETENTION_DAYS=30
MX_VERIFY_BEFORE_SEND=true
SMTP_VERIFY_MAILBOX=true       # SMTP RCPT probe at send-time; dead mailboxes -> garbage
